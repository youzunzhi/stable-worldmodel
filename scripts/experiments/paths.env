# Shared shou defaults. Set any variable before invocation to override it.
# REPO_ROOT is derived so the checkout can live at any path on shou.

REPO_ROOT=${REPO_ROOT:-$(cd "$EXPERIMENTS_DIR/../.." && pwd)}
ENV_ROOT=${ENV_ROOT:-/ssd/sxu/miniconda3/envs/lewm}
DATA_ROOT=${DATA_ROOT:-/ssd/sxu/workspace/data/stable-worldmodel}
RUN_ROOT=${RUN_ROOT:-$REPO_ROOT/outputs/experiments}

DATASETS_ROOT=${DATASETS_ROOT:-$DATA_ROOT/hf/datasets}
MODELS_ROOT=${MODELS_ROOT:-$DATA_ROOT/hf/models}
CONVERTED_DATA_ROOT=${CONVERTED_DATA_ROOT:-$DATA_ROOT/converted}

export \
    REPO_ROOT \
    ENV_ROOT \
    DATA_ROOT \
    RUN_ROOT \
    DATASETS_ROOT \
    MODELS_ROOT \
    CONVERTED_DATA_ROOT
